COMPOSE_PROJECT_NAME=aas-vpn
VPN_NETWORK_NAME=aas-vpn
VPN_DOMAIN=awg.example.com
PORTAL_DOMAIN=example.com
# Optional WebAuthn RP ID; defaults to the portal hostname.
WEBAUTHN_RP_ID=
VPN_SITE_ADDRESS=awg.example.com
PORTAL_SITE_ADDRESS=example.com
SERVER_PUBLIC_IP=203.0.113.10
AWG_PORT=443
AWG_FALLBACK_PORT=1234
TZ=Europe/Moscow

COOKIE_DOMAIN=.example.com

# Zvonok: campaign type "Звонок на проверочный номер".
ZVONOK_PUBLIC_KEY=
ZVONOK_CAMPAIGN_ID=304234140
ZVONOK_DIAL_NUMBERS=+74952960000,+78122420000,+79305558607
# Уточняется по реальному ответу API вашей кампании.
ZVONOK_SUCCESS_STATUSES=processed,success,confirmed,pincode_ok

# Optional: existing Docker volume names when migrating an installation.
# AWG2_VOLUME_NAME=root_awg2_wireguard
# ADGUARD_WORK_VOLUME_NAME=root_adguard_work
# PORTAL_DATA_VOLUME_NAME=root_portal_data

# Normally discovered from the AWG controller. Set only to the actual client subnet if needed.
VPN_CLIENT_CIDR=
AWG_CLIENT_DNS=10.42.42.44
# Docker subnet must contain the fixed service addresses 10.42.42.1/44/45/46.
VPN_DOCKER_CIDR=10.42.42.0/24
