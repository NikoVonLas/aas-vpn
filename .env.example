VPN_DOMAIN=awg.example.com
PORTAL_DOMAIN=example.com
SERVER_PUBLIC_IP=203.0.113.10
AWG_PORT=443
TZ=Europe/Moscow

# Portal administrator (used only for /admin).
PORTAL_ADMIN_USER=admin
PORTAL_ADMIN_PASSWORD=change-me
PORTAL_ADMIN_TOTP_SECRET=generate-a-base32-secret
PORTAL_SESSION_SECRET=generate-a-long-random-value

# Zvonok: campaign type "Звонок на проверочный номер".
ZVONOK_PUBLIC_KEY=
ZVONOK_CAMPAIGN_ID=304234140
# Уточняется по реальному ответу API вашей кампании.
ZVONOK_SUCCESS_STATUSES=processed,success,confirmed

# Credentials for the internal wg-easy API. Never commit .env.
AWG_API_URL=http://awg-easy:51821
AWG_ADMIN_USERNAME=
AWG_ADMIN_PASSWORD=
AWG_ADMIN_TOTP_SECRET=
