{$VPN_SITE_ADDRESS} {
    redir https://{$PORTAL_DOMAIN}/admin 308
    encode gzip zstd
    header {
        +Set-Cookie "wg-easy=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
}

{$PORTAL_SITE_ADDRESS} {
    reverse_proxy portal:8080
    encode gzip zstd
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }
}
